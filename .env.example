# Copie para `.env` e preencha. O `.env` real nunca vai pro git.

# ---------- Banco (Neon PostgreSQL) ----------
# DATABASE_URL = string COM "-pooler" no host (usada pelo app)
# DIRECT_URL   = mesma string SEM "-pooler" (usada por prisma db push/migrate)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/neondb?sslmode=require"

# ---------- Cérebro (Claude API) ----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_OWNER_CHAT_ID=""

# ---------- Transcrição de áudio (Groq Whisper) ----------
GROQ_API_KEY=""

# ---------- Login no dashboard (NextAuth) ----------
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Cron ----------
# Usado pelos endpoints /api/cron/* e pelo worker do Railway (worker/index.js)
# que bate neles no header `x-cron-secret`.
CRON_SECRET=""

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TZ_PADRAO="America/Sao_Paulo"
